# ─────────────────────────────────────────────────────────────────
#  OmniRoute — starter .env
# ─────────────────────────────────────────────────────────────────
#  This is a CURATED SUBSET of the required/most-used variables,
#  meant to get a local instance running quickly. OmniRoute's own
#  .env.example (in the upstream repo) documents 20+ sections and
#  every variable the runtime reads — consult it before relying on
#  anything beyond what's listed here:
#  https://github.com/diegosouzapw/OmniRoute/blob/main/.env.example
#
#  Usage:
#    1. Clone OmniRoute itself (this repo does not vendor its code):
#         git clone https://github.com/diegosouzapw/OmniRoute.git
#    2. Copy this file (or their .env.example) into that clone as `.env`
#    3. Fill in the values below
#    4. See docs/omniroute-setup.md in this repo for the run steps
# ─────────────────────────────────────────────────────────────────

# ── Required secrets — generate real values, do not leave blank ──

# Signs/verifies dashboard session cookies.
# Generate: openssl rand -base64 48
JWT_SECRET=

# Encrypts API keys stored in the local SQLite database.
# Generate: openssl rand -hex 32
API_KEY_SECRET=

# Initial admin dashboard password — change on first login.
# Default upstream value is "CHANGEME"; do not use that in anything
# reachable beyond your own machine.
INITIAL_PASSWORD=

# ── Networking ──

# Dashboard + OpenAI-compatible API port (single endpoint: /v1/...).
PORT=20128
DASHBOARD_PORT=20128
API_PORT=20129

# ── Provider credentials (add only the ones you actually use) ──
# OmniRoute proxies to whichever providers you configure from its
# dashboard or via these env vars. Never commit real keys — this
# file is a template only.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
